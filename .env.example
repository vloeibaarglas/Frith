# Generate with: openssl rand -base64 32
# Multiple keys are allowed, comma-separated. Every value in Authorization: Bearer <key> works.
UPLOAD_TOKEN=change-me
PUBLIC_URL=http://localhost:8080
UPLOAD_MAX_MB=500
# URL prefix files are served under (default /, e.g. /u)
UPLOAD_PATH=/
# UPLOAD_LIST=true
# UPLOAD_ORIGINAL_NAME=true
